// Cloudflare Workers static assets: Cloudflare serves the repository root.
// .assetsignore lists the files that are not part of the site.
// _redirects holds the redirects, and _headers holds the response headers.
{
  "name": "fusion-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    // /pricing redirects to /pricing/, and /pricing/ serves pricing/index.html.
    "html_handling": "auto-trailing-slash",
    // An unknown path gets 404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "fusionframework.ai", "custom_domain": true },
    { "pattern": "www.fusionframework.ai", "custom_domain": true }
  ],
  // The site is served only at fusionframework.ai, not at workers.dev.
  // Each branch build still gets a preview URL.
  "workers_dev": false,
  "preview_urls": true
}
